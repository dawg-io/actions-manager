---
// Replaces Starlight's plain-text site title with the ActionsManager lockup:
// shield + two-tone wordmark, matching the app's BrandLogo component.
import logo from '../assets/shield-icon-transparent.svg';

// The home page also gets top-level links beside the lockup; other pages
// navigate with the sidebar. BASE_URL has no trailing slash on the preview.
const isHome = Astro.locals.starlightRoute.id === '';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
	{ label: 'Docs', href: `${base}getting-started/quick-start.html` },
	{ label: 'Features', href: `${base}#features` },
	{ label: 'Quick start', href: `${base}#quick-start` },
	{ label: 'Security', href: `${base}security/security.html` },
];
---

<a href={import.meta.env.BASE_URL} class="site-title">
	<img src={logo.src} alt="" aria-hidden="true" />
	<span class="wordmark" translate="no">
		<span class="actions">Actions</span><span class="manager">Manager</span>
	</span>
</a>
{
	isHome && (
		<nav class="home-nav" aria-label="Main">
			{links.map(({ label, href }) => (
				<a {href}>{label}</a>
			))}
		</nav>
	)
}

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	/* Fills the header's content height (--sl-nav-height minus padding):
	   2rem on phones, 2.5rem from 50rem up. Text sizes follow the app
	   BrandLogo's sm / md steps. */
	img {
		height: 2rem;
		width: auto;
	}
	.wordmark {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
			'Helvetica Neue', Arial, sans-serif;
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	@media (min-width: 50rem) {
		img {
			height: 2.5rem;
		}
		.wordmark {
			font-size: 1.5rem;
		}
	}
	/* Colors are the app's text-primary / primary tokens (tailwind.config). */
	.actions {
		color: #f8fafc;
	}
	.manager {
		color: #3b82f6;
	}
	:global([data-theme='light']) .actions {
		color: #0f172a;
	}
	:global([data-theme='light']) .manager {
		color: #0066cc;
	}
	.home-nav {
		display: none;
		gap: 1.5rem;
		margin-inline-start: 2rem;
		font-size: var(--sl-text-sm);
	}
	.home-nav a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.home-nav a:hover {
		color: var(--sl-color-white);
	}
	@media (min-width: 72rem) {
		.home-nav {
			display: flex;
			align-items: center;
		}
	}
</style>
