---
// The product demo as a click-to-load player (home page, Product Demo page):
// a local poster until the visitor presses play, so opening a page makes no
// YouTube request. Without JS the link opens YouTube. On the home page, keep it
// inside a band: its frame and script as siblings between two bands would break
// the dark-mode separator's "+" selector in theme.css.
import { Image } from 'astro:assets';
import poster from '../content/docs/assets/screenshots/walkthrough/09-project-workspace-actions.png';

interface Props {
	sizes: string;
	/** Astro's default is lazy; pass eager when the player is above the fold. */
	loading?: 'eager' | 'lazy';
}

const { sizes, loading } = Astro.props;
const videoId = 'WkDYK7pCBjI';
---

<div class="frame landing-ink not-content">
	<a
		class="player"
		href={`https://youtu.be/${videoId}`}
		data-video-id={videoId}
		aria-label="Play the ActionsManager product demo (loads the YouTube player)"
	>
		<Image src={poster} alt="" widths={[640, 960, 1280]} {sizes} {loading} />
		<span class="play" aria-hidden="true">
			<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
		</span>
	</a>
</div>

<script>
	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-video-id]')) {
		link.addEventListener('click', (event) => {
			// Modified clicks keep their meaning: open YouTube in a new tab or window.
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoId}?autoplay=1`;
			iframe.title = 'ActionsManager product demo: multi-repository workflow rollout';
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			link.replaceWith(iframe);
			iframe.focus();
		});
	}
</script>

<style>
	/* landing-ink keeps the frame dark in light mode, as on the home page. */
	.frame {
		aspect-ratio: 16 / 9;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-gray-6);
	}
	/* The iframe is created at runtime, so it carries no scope attribute. */
	.player,
	.frame :global(iframe) {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.player img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		opacity: 0.45;
		transition: opacity 0.2s;
	}
	.player:hover img,
	.player:focus-visible img {
		opacity: 0.6;
	}
	/* Inset, or the frame's overflow: hidden clips it. */
	.player:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -4px;
	}
	.play {
		position: absolute;
		inset: 0;
		margin: auto;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		background: var(--sl-color-accent);
		color: #fff;
	}
	.play svg {
		width: 1.75rem;
		height: 1.75rem;
		margin-inline-start: 0.2rem;
	}
</style>
