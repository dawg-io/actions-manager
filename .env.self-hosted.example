# =============================================================================
# Self-Hosted Deployment Environment Configuration
# =============================================================================
# This configuration is for the **Self-hosted build** of Actions Manager —
# single-tenant installations that customers run on their own infrastructure.
#
# DO NOT use this file for cloud / GitHub Marketplace deployments — see
# .env.cloud.example instead.
#
# Self-hosted startup rules (see backend/mode_validation.py):
#   * LICENSE_KEY is OPTIONAL. Missing, invalid, expired, or tampered keys
#     fall back to the Free tier — the application keeps running.
#   * GITHUB_WEBHOOK_SECRET is NOT required. Marketplace webhooks are
#     disabled in self-hosted mode.
#   * SQLite is the default database; PostgreSQL is optional.
#   * Tier override env vars (ACCOUNT_TYPE, TIER, PLAN, FORCE_TIER,
#     OVERRIDE_TIER) are still rejected — the JWT license is the ONLY
#     supported upgrade path.
#
# Copy this file to .env.self-hosted and fill in your values.
# Start with the REQUIRED section first, then come back for optional settings.
# Treat .env.self-hosted as sensitive. Never commit a real .env file.
# =============================================================================

# =============================================================================
# REQUIRED: Installation Mode (DO NOT CHANGE)
# =============================================================================
INSTALLATION_MODE=self-hosted

# REQUIRED for first run in this template:
# - production (recommended/default): stricter checks for beta operators
# - development: local testing only; permits debug/mocks/default admin placeholders
ENVIRONMENT=production

# =============================================================================
# OPTIONAL: License Configuration (Self-Hosted Only)
# =============================================================================
# JWT-based license key for self-hosted installations.
# The license key is an RS256-signed JWT token containing:
# - tier: The license tier ("free", "professional", or "enterprise")
# - exp: (optional) Expiration timestamp
#
# No paid plans are currently available during the self-hosted beta.
# If LICENSE_KEY is not provided, the installation defaults to the beta/free tier.
# Future paid/commercial license behavior may change before general availability.
# If the license is invalid or expired, the installation falls back to free.
#
# No LICENSE_SECRET is required. License signatures are verified using an
# RSA public key embedded in the application (backend/license.py).
#
# LICENSE_KEY=your_jwt_license_key_here

# =============================================================================
# OPTIONAL: Application URLs (runtime env vars — no image rebuild needed)
# =============================================================================
# For PAT login: leave this section commented out. The frontend auto-detects
# the browser location (window.location), so the app works whether you access
# it via localhost, a LAN IP address, or a custom domain — with no configuration.
#
# For GitHub OAuth login: GitHub needs a fixed callback URL registered in your
# OAuth App settings. Use APP_URL for the simple case:
#
#   APP_URL=http://192.168.1.100:8080
#
# The container startup script derives BACKEND_URL, FRONTEND_URL, and
# WEBSOCKET_URL automatically from APP_URL. For HTTPS:
#
#   APP_URL=https://actions.example.com
#   (WebSocket becomes wss://actions.example.com/ws automatically)
#
# COMMON MISTAKE — do NOT use localhost unless every user runs the container
# on their own machine:
#   APP_URL=http://localhost:8080   ← WRONG for shared servers
#
# Deprecated aliases (still work, but prefer bare APP_URL):
#   VITE_APP_URL=...   — same as APP_URL; APP_URL takes priority if both set
#
# Advanced: override each URL individually when you need different hosts or
# ports for each service (not typical for self-hosted):
#   VITE_BACKEND_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080
#   VITE_FRONTEND_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080
#   VITE_WEBSOCKET_URL=ws://YOUR_SERVER_IP_OR_DOMAIN:8080/ws
#
# Backward compat: VITE_APP_URL and REACT_APP_* vars from pre-migration
# .env.self-hosted files are still accepted without modification.
#
# APP_URL=

# =============================================================================
# OPTIONAL: GitHub OAuth Configuration
# =============================================================================
# Only required if you want browser-based OAuth login.
# PAT login through the UI does NOT require these values at startup.
# Register your OAuth app at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional server-level GitHub token for automation / non-user API operations.
# This is NOT the same as a user-level saved PAT configured through the UI.
# Most self-hosted users should sign in with a PAT in the app instead of
# putting a personal token in this file.
# GITHUB_TOKEN=your_server_level_github_token

# =============================================================================
# REQUIRED for PAT login: Security Key
# =============================================================================
# Used to encrypt/decrypt saved personal access tokens.
# Generate ONCE with: openssl rand -hex 32
# Paste the output below and keep it the same on every container restart.
# If unset, PAT login will fail with a 503 error.
# WARNING: Changing SECRET_KEY after first run will invalidate all saved tokens.
# SECRET_KEY=your_secret_key_here

# =============================================================================
# SECURITY: HTTPS Requirement
# =============================================================================
# ⚠️  CRITICAL SECURITY REQUIREMENT: Never expose ActionsManager over plain HTTP
# on a network or to the internet. Personal Access Tokens will be transmitted in
# plaintext and can be intercepted.
#
# By default, the application REFUSES TO START when APP_URL uses non-local HTTP
# (e.g. http://192.168.1.100:8080 or http://yourserver.example.com:8080).
# PAT login is also blocked per-request over non-local HTTP as defense in depth.
#
# Localhost HTTP (http://localhost:8080 or http://127.0.0.1:8080) is allowed
# because it's local-only and safe for testing.
#
# PRODUCTION DEPLOYMENTS:
# - Use HTTPS with a reverse proxy (Caddy, Traefik, or nginx)
# - See docs/SELF_HOSTED_INSTALL.md#using-https-with-reverse-proxy for examples
# - The application detects HTTPS via the X-Forwarded-Proto header from your proxy
#
# TESTING/DEVELOPMENT OVERRIDE (NOT RECOMMENDED):
# Set this to true ONLY for local network testing without HTTPS.
# Never enable this on a production deployment accessible from the internet.
# ALLOW_INSECURE_HTTP=false

# =============================================================================
# OPTIONAL: Database Configuration
# =============================================================================
# If not set, the application uses SQLite by default.
# For larger deployments, PostgreSQL is recommended
# POSTGRES_USER=your_postgres_user
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_DB=actions_manager
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@localhost:5432/actions_manager

# =============================================================================
# OPTIONAL: Development Settings
# =============================================================================
# Enable debug mode for additional logging
DEBUG_MODE=false

# Enable mock responses for development (without real GitHub authentication)
USE_MOCK_RESPONSES=false

# Disable interactive API docs (/docs, /redoc, /openapi.json).
# Auto-disabled in production (ENVIRONMENT=production). Set to false to keep
# docs enabled regardless of environment.
# DISABLE_API_DOCS=true

# =============================================================================
# OPTIONAL: Email Notifications (SMTP)
# =============================================================================
# One installation sends through one SMTP account/relay. Recipients and event
# subscriptions are configured separately in the app, not here.
# If SMTP_HOST or SMTP_FROM_ADDRESS is unset, notification emails cannot be
# sent (the "Send Test Email" action returns a clear configuration error).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=notifications@yourcompany.com
# SMTP_FROM_NAME=ActionsManager
