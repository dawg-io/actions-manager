# ActionsManager.xyz Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Installation Mode Configuration
# =============================================================================
# Determines the operation mode of the application
# Values: 'cloud' or 'self-hosted' (default: 'self-hosted')
# - 'cloud': Multi-tenant cloud deployment with marketplace integration
# - 'self-hosted': Single-tenant self-hosted deployment
INSTALLATION_MODE=self-hosted

# =============================================================================
# License Configuration (Self-Hosted Only)
# =============================================================================
# JWT-based license key for self-hosted installations
# The license key is a signed JWT token containing:
# - tier: The license tier ("free", "professional", or "enterprise")
# - exp: (optional) Expiration timestamp
# 
# If LICENSE_KEY is not provided, the installation defaults to the free tier.
# If the license is invalid or expired, the installation falls back to the
# free tier.
#
# Example JWT payload:
# {
#   "tier": "professional",
#   "exp": 1735689600  # Optional: Unix timestamp for expiration
# }
#
# Professional and Enterprise keys are vendor-issued RS256 JWTs. Customers
# configure only LICENSE_KEY; no signing secret is required.
#
# LICENSE_KEY=your_jwt_license_key_here

# =============================================================================
# Application URLs
# =============================================================================
# Backend API URL (used for OAuth callbacks and CORS)
VITE_BACKEND_URL=http://localhost:8000

# Frontend URL (used for redirects after authentication)
VITE_FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated list of exact origins).
# If unset, falls back to VITE_FRONTEND_URL, otherwise "*".
# When the resolved list contains "*", credentialed CORS is disabled
# automatically (browsers also reject "*" with credentials).
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#CORS_ALLOWED_ORIGINS=

# =============================================================================
# Security
# =============================================================================
# Required for encrypting saved PATs. Generate with: openssl rand -hex 32
# If unset, PAT login will fail with a 503 error.
# SECRET_KEY=your_secret_key_here

# =============================================================================
# GitHub Authentication Configuration
# =============================================================================
# OAuth app credentials are optional and only required for OAuth login.
# PAT login through the UI works without these values.
# Register your OAuth app at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional server-level GitHub token for automation / non-user API operations.
# This is NOT the same as the saved PAT each user can configure in the UI.
# GITHUB_TOKEN=your_server_level_github_token

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# If not set, the application will use SQLite for testing
# POSTGRES_USER=your_postgres_user
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_DB=actions_manager
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# Development Settings
# =============================================================================
# Enable mock responses for development (without GitHub OAuth)
USE_MOCK_RESPONSES=false

# Enable debug mode for additional logging
DEBUG_MODE=false

# =============================================================================
# Admin Panel Configuration
# =============================================================================
# Admin credentials for accessing the admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# =============================================================================
# AI Features (Optional)
# =============================================================================
# OpenAI API key for AI-powered workflow generation
# OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# GitHub Marketplace & Webhooks (Cloud Mode)
# =============================================================================
# Webhook secret for validating GitHub webhook payloads
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Comma-separated list of GitHub webhook IP ranges to allow
# GITHUB_WEBHOOK_IPS=192.30.252.0/22,185.199.108.0/22,140.82.112.0/20

# Verify webhook IP addresses (set to false to disable IP verification)
# VERIFY_WEBHOOK_IP=true

# Rate limit for webhook endpoints (requests per minute)
# WEBHOOK_RATE_LIMIT=60

# Use stubbed marketplace API for testing (development only)
# USE_STUBBED_MARKETPLACE_API=false
