# Example frontend environment for a remote dev deployment.
#
# Copy to .env.dev and point these at your own dev hosts. That file is
# gitignored: it holds real infrastructure hostnames, which do not belong in
# the tree (this repository is promoted to a public one).
#
# Only read when Vite is started with `--mode dev`; the default `npm run dev`
# uses .env / .env.development instead.
VITE_BACKEND_URL=https://dev-api.example.com
VITE_FRONTEND_URL=https://dev.example.com
VITE_WEBSOCKET_URL=wss://dev-api.example.com/ws
