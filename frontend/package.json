    "jsdom": "^25.0.1",
    "postcss": "^8.5.20",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.18",
    "typescript": "4.9.5",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
